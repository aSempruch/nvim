" Shared navigation habits from ~/.config/nvim.
let mapleader = " "
set relativenumber
set scrolloff=10
set ignorecase
set smartcase

" Telescope-style file navigation using PyCharm actions.
nmap <leader>ff <Action>(GotoFile)
nmap <leader>fr <Action>(RecentFiles)
nmap <leader>fg <Action>(FindInPath)

" Find references to the symbol under the cursor.
nmap gr <Action>(FindUsages)

" Match the Flash mappings in ~/.config/nvim/lua/plugins/navigation.lua.
" Requires the vim-flash JetBrains plugin.
nmap s <Action>(flash.search)
xmap s <Action>(flash.search)
nmap f <Action>(flash.find)
xmap f <Action>(flash.find)
nmap F <Action>(flash.find_backward)
xmap F <Action>(flash.find_backward)
nmap S <Action>(flash.treesitter)
xmap S <Action>(flash.treesitter)
omap r <Action>(flash.remote)

" Move between editor splits, as in Neovim.
nmap <C-h> <C-w>h
nmap <C-j> <C-w>j
nmap <C-k> <C-w>k
nmap <C-l> <C-w>l

" Cycle editor file tabs, like Neovim's bufferline.
nmap <S-h> <Action>(PreviousTab)
nmap <S-l> <Action>(NextTab)

" Keep Vim redo and half-page scrolling; use Option for Run and Debug.
sethandler <C-r> n:vim
sethandler <C-d> n:vim
sethandler <A-r> n:vim
sethandler <A-d> n:vim
nmap <A-r> <Action>(Run)
nmap <A-d> <Action>(Debug)

" Search and launch a run configuration by name.
nmap <leader>r <Action>(RunAnything)

" Debugger controls.
nmap <leader>db <Action>(ToggleLineBreakpoint)
nmap <leader>de <Action>(EvaluateExpression)
nmap <leader>dn <Action>(StepOver)
nmap <leader>dc <Action>(RunToCursor)
nmap <leader>dr <Action>(Resume)

" Show available leader mappings after Space.
set which-key
set timeoutlen=3000
let g:WhichKeyDesc_find = "<leader>f Find"
let g:WhichKeyDesc_find_files = "<leader>ff Find files"
let g:WhichKeyDesc_find_recent = "<leader>fr Recent files"
let g:WhichKeyDesc_find_grep = "<leader>fg Find in files"
let g:WhichKeyDesc_run = "<leader>r Run configuration by name"
let g:WhichKeyDesc_debug = "<leader>d Debug"
let g:WhichKeyDesc_debug_breakpoint = "<leader>db Toggle breakpoint"
let g:WhichKeyDesc_debug_evaluate = "<leader>de Evaluate expression"
let g:WhichKeyDesc_debug_next = "<leader>dn Step over"
let g:WhichKeyDesc_debug_cursor = "<leader>dc Run to cursor"
let g:WhichKeyDesc_debug_resume = "<leader>dr Resume to next breakpoint"

" Git blame annotations and branch selection.
nmap <leader>gb <Action>(Annotate)
nmap <leader>gB <Action>(Git.Branches)
let g:WhichKeyDesc_git = "<leader>g Git"
let g:WhichKeyDesc_git_blame = "<leader>gb Git blame annotations"
let g:WhichKeyDesc_git_branches = "<leader>gB Git branches"
