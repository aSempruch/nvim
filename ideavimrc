" Shared navigation habits from ~/.config/nvim.
" Leader actions are available in normal, visual, select, and operator-pending modes.
let mapleader = " "
set relativenumber
set scrolloff=10
set ignorecase
set smartcase

" Telescope-style file navigation using PyCharm actions.
map <leader>ff <Action>(GotoFile)
map <leader>fr <Action>(RecentFiles)
map <leader>fg <Action>(FindInPath)

" Find references to the symbol under the cursor.
nmap gr <Action>(FindUsages)

" Match the Flash mappings in ~/.config/nvim/lua/plugins/navigation.lua.
" Requires the vim-flash JetBrains plugin.
nmap s <Action>(flash.search)
xmap s <Action>(flash.search)
nmap f <Action>(flash.find)
xmap f <Action>(flash.find)
nmap F <Action>(flash.find_backward)
xmap F <Action>(flash.find_backward)
nmap S <Action>(flash.treesitter)
xmap S <Action>(flash.treesitter)
omap r <Action>(flash.remote)

" Move between editor splits, as in Neovim.
nmap <C-h> <C-w>h
nmap <C-j> <C-w>j
nmap <C-k> <C-w>k
nmap <C-l> <C-w>l

" Focus PyCharm tool windows from the editor.
map <leader>wf <Action>(ActivateProjectToolWindow)
map <leader>wr <Action>(ActivateRunToolWindow)
map <leader>wd <Action>(ActivateDebugToolWindow)
map <leader>wt <Action>(ActivateTerminalToolWindow)
map <leader>wg <Action>(ActivateVersionControlToolWindow)
map <leader>ws <Action>(ActivateStructureToolWindow)

" Cycle editor file tabs, like Neovim's bufferline.
nmap <S-h> <Action>(PreviousTab)
nmap <S-l> <Action>(NextTab)

" Keep Ctrl-D as Vim's half-page scroll in normal mode.
sethandler <C-d> n:vim

" Run the selected configuration, choose one, or search with Run Anything.
map <leader>rr <Action>(Run)
map <leader>ra <Action>(RunAnything)
map <leader>rs <Action>(ChooseRunConfiguration)

" Start or control a debug session.
map <leader>dd <Action>(Debug)
map <leader>db <Action>(ToggleLineBreakpoint)
map <leader>de <Action>(EvaluateExpression)
map <leader>dn <Action>(StepOver)
map <leader>di <Action>(StepInto)
map <leader>do <Action>(StepOut)
map <leader>dc <Action>(RunToCursor)
map <leader>dr <Action>(Resume)

